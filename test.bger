define int fib(int n) {
    if n <= 1 {
        return n;
    }

    return call fib(n - 1) + call fib(n - 2);
}

define int factorial(int n) {
    if n <= 1 {
        return 1;
    }

    return n * call factorial(n - 1);
}

define int countdown(int n) {
    if n <= 0 {
        return 0;
    }

    return call countdown(n - 1);
}



print(call factorial(5));
print(call fib(10));

set int x = 2;
set int y = 50;

print(call countdown(x * y));

define int sum(int n) {
    set int x = 2;

    if n <= 0 {
        return 0;
    }

    return n + call sum(n - 1);
}

set char z = 'd';

print(call sum(z));

define void printWow() {
    print("Wow");
}

call printWow();
call sum(z);